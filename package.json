{
  "name": "parle",
  "private": true,
  "version": "0.0.0",
  "description": "See what the internet has already said about the page you are reading.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:safari": "pnpm --filter @parle/extension build:safari",
    "package:safari": "pnpm --filter @parle/extension package:safari",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo run test",
    "lint": "node store/lint.ts",
    "check": "pnpm run typecheck && turbo run test && pnpm run lint",
    "check:release": "node store/check-release.ts apps/extension/.output store/screenshots",
    "version:show": "node store/version.ts",
    "version:bump": "node store/version.ts --set",
    "store:status": "node store/cws.ts status",
    "store:release": "node store/cws.ts release apps/extension/.output",
    "publish:qa-zip": "node scripts/publish-chrome-mv3-qa.ts apps/extension/.output",
    "dev": "turbo run dev --filter=@parle/extension",
    "e2e": "turbo run e2e --filter=@parle/extension"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "effect": "4.0.0-beta.105",
    "playwright": "^1.62.1",
    "tsx": "^4.23.11",
    "turbo": "2.10.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
