{
  "name": "parle",
  "private": true,
  "version": "0.0.0",
  "description": "See what the internet has already said about the page you are reading.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/run-turbo-ci.ts run build",
    "build:safari": "node scripts/run-turbo-ci.ts run build:safari --filter=@parle/extension",
    "package:safari": "pnpm build:safari && pnpm --filter @parle/extension package:safari",
    "zip:chrome": "node scripts/run-turbo-ci.ts run zip:chrome --filter=@parle/extension",
    "typecheck": "turbo run typecheck typecheck:tools",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test": "turbo run test",
    "lint": "node store/lint.ts",
    "check": "turbo run typecheck typecheck:tools test lint",
    "ci:quality": "node scripts/run-turbo-ci.ts run typecheck typecheck:tools test lint build zip:chrome audit:chrome",
    "ci:local": "node scripts/run-local-ci.ts",
    "audit:chrome": "node store/check-release.ts apps/extension/.output",
    "check:release": "node store/check-release.ts apps/extension/.output store/screenshots",
    "version:show": "node store/version.ts",
    "version:bump": "node store/version.ts --set",
    "store:status": "node store/cws.ts status",
    "store:release": "node store/check-listing.ts && node store/cws.ts release apps/extension/.output",
    "publish:qa-zip": "node scripts/publish-chrome-mv3-qa.ts apps/extension/.output",
    "dev": "turbo run dev --filter=@parle/extension",
    "dev:site": "turbo run dev --filter=@parle/site",
    "build:site": "turbo run build --filter=@parle/site",
    "e2e": "node scripts/run-turbo-ci.ts run e2e --filter=@parle/extension",
    "e2e:torture": "node scripts/run-turbo-ci.ts run e2e:torture --filter=@parle/extension"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "effect": "4.0.0-beta.105",
    "playwright": "^1.62.1",
    "run-local-ci": "0.18.1",
    "tsx": "^4.23.11",
    "turbo": "2.10.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
