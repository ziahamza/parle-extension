node_modules/
dist/
.output/
.wxt/
.turbo/
.e2e-profile/
# One per build the suite runs: Chrome, the Safari-shaped build, and the
# side-panel run that needs its own window geometry.
.e2e-profile-*/
.e2e-shots/
# Regenerated by `pnpm tsx store/showcase-ux.ts`
store/showcase/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store

# Working notes. Tracked deliberately — the tickets are the roadmap, the
# research carries measurements that would otherwise have to be redone, and
# `everlasting/` is the corpus that several proposed relevance rules were
# REFUSED against. See HANDOFF.md §9.
.claude/
.agents/

# A held copy of a BUILD, not working notes — it shares a directory name and
# nothing else. Regenerated by `pnpm build`.
apps/extension/.scratch/

# Throwaway API responses left over from spikes: a GitHub rate-limit error
# (which carries this machine's IP), an iTunes search page, an X payload.
# Nothing reads them and none of them is ours to republish.
.scratch/parle-mvp/issues/*.json

# Research leftovers, not project files. `notes-00001.*` are a shard of X's
# Community Notes dump — ticket 15 established there is no licence to
# redistribute it, so it must never enter this history.
notes-*.tsv
notes-*.zip
ua.txt
rall.xml
skills-lock.json

# Sweep run artifacts, like .e2e-shots — regenerated by `pnpm e2e:sweep`.
.e2e-sweep/

# The Steel spike's raw captures. VERDICT.md and the scripts are the
# deliverable; `out/` is 1.1 MB of one afternoon's logs.
spike/steel/out/

# Built for upload by `store/make-art.ts`; regenerating beats versioning a zip.
store/parle-chrome-store.zip

# Local staging for the durable QA zip. Published to qa/chrome-mv3-latest, never to main.
dist-qa/
